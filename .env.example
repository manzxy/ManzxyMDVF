# ═══════════════════════════════════════════════════════
#  ManzxyMD — contoh variabel environment
#  Salin jadi `.env` atau set langsung di shell / PM2 / Docker.
# ═══════════════════════════════════════════════════════

# ── Bot ──
PAIRING_NUMBER=628xxxxxxxxxx
# PORT=3000

# ── Pembayaran (KiPay QRIS) ──
KIPAY_API_KEY=qpg_pub_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Panel web ──
# Alamat publik panel (hanya domain, TANPA /panel). Dipakai untuk redirect URI OAuth & link referral.
# Alamat ini juga bisa diubah dari panel: Owner → Alamat panel (tanpa restart).
WEB_PANEL_URL=https://panel.manzxy.biz.id

# ── Login OAuth Google / GitHub (OPSIONAL) ──
# Cara termudah: isi dari panel web → tab OWNER → 🔐 LOGIN GOOGLE / GITHUB.
# Variabel di bawah hanya perlu diisi bila ingin konfigurasi lewat file (deployment otomatis).
# Nilai yang disimpan dari panel web menang atas nilai environment.
#
# Google : https://console.cloud.google.com/apis/credentials
#          Authorized redirect URI: <WEB_PANEL_URL>/api/auth/google/callback
# GitHub : https://github.com/settings/developers  (New OAuth App)
#          Authorization callback URL: <WEB_PANEL_URL>/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OmnifyAnime API (fitur anime) ──
# Dapatkan/lihat key di https://anime.omnifylabs.sbs/
OMNIFY_ANIME_KEY=

# ── Lisensi ManzxyMD Free (WAJIB) ──
# Bot TIDAK jalan tanpa key dari owner. Dapatkan fingerprint: node index.js --fingerprint
# Kirim fingerprint ke owner, lalu pasang key yang diberikan (atau .setkey <key> di bot).
MZ_LICENSE_KEY=
# Catatan: verifikasi memakai public key penerbit (.license-public.pem).
# Jangan mengubah/menghapus file tersebut.
